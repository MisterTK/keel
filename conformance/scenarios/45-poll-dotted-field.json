{
  "name": "poll-dotted-field",
  "description": "CCR-8: until.field is a dotted path walked through nested objects. A missing intermediate, a non-object intermediate, or a key that merely CONTAINS a dot all fail open (returned as-is, one attempt). The E016 message prints the dotted path verbatim.",
  "policy": { "target": {
    "ops.example": { "poll": { "interval": "10s", "deadline": "25s", "until": { "field": "response.state", "terminal": ["SUCCEEDED", "FAILED"] } } }
  } },
  "steps": [
    { "call": { "target": "ops.example",
        "request": { "op": "GET ops.example/v1/op1", "idempotent": true, "args_hash": "h1" },
        "effect": [ { "status": "ok", "payload": { "response": { "state": "RUNNING" } } },
                    { "status": "ok", "payload": { "response": { "state": "SUCCEEDED" } } } ],
        "expect": { "result": "ok", "payload": { "response": { "state": "SUCCEEDED" } }, "attempts": 2 } } },
    { "call": { "target": "ops.example",
        "request": { "op": "GET ops.example/v1/op2", "idempotent": true, "args_hash": "h2" },
        "effect": [ { "status": "ok", "payload": { "metadata": { "state": "RUNNING" } } } ],
        "expect": { "result": "ok", "payload": { "metadata": { "state": "RUNNING" } }, "attempts": 1 } } },
    { "call": { "target": "ops.example",
        "request": { "op": "GET ops.example/v1/op3", "idempotent": true, "args_hash": "h3" },
        "effect": [ { "status": "ok", "payload": { "response": "flat" } } ],
        "expect": { "result": "ok", "attempts": 1 } } },
    { "call": { "target": "ops.example",
        "request": { "op": "GET ops.example/v1/op4", "idempotent": true, "args_hash": "h4" },
        "effect": [ { "status": "ok", "payload": { "response.state": "SUCCEEDED" } } ],
        "expect": { "result": "ok", "attempts": 1 } } },
    { "call": { "target": "ops.example",
        "request": { "op": "GET ops.example/v1/op5", "idempotent": true, "args_hash": "h5" },
        "effect": [ { "status": "ok", "payload": { "response": { "state": "RUNNING" } } },
                    { "status": "ok", "payload": { "response": { "state": "RUNNING" } } },
                    { "status": "ok", "payload": { "response": { "state": "RUNNING" } } } ],
        "expect": { "result": "error", "attempts": 3,
                    "error": { "code": "KEEL-E016", "class": "other",
                               "message": "GET ops.example/v1/op5 poll deadline exceeded: 'response.state' not terminal after 25000ms" } } } },
    { "report_expect": { "clock_ms": 30000, "targets": { "ops.example": { "calls": 5, "attempts": 8, "successes": 4, "failures": 1 } } } }
  ]
}
