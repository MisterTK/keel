{
  "name": "poll-absent-through-envelope",
  "description": "CCR-11 through the ADAPTER HTTP ENVELOPE — the only payload shape real traffic takes. Scenario 49 pins `until.absent` against bare payload objects; every Python/Node/Rust HTTP pack hands the core a `{status, headers, body_b64}` envelope instead, so the envelope decode path and the absent rule were never exercised together. Same captured google.longrunning.Operation body sequence as 49, base64-encoded: three running bodies {\"name\": \"...\"} then a terminal body carrying `done`. Also pins the LIMIT of `absent` (final call): a BODYLESS envelope — status + headers with no `body_b64`, a 204/304 — fails open on attempt one EVEN under `absent = \"pending\"`, because the payload never parsed into a JSON object and `until` is not consulted for it at all. That ordering is pre-CCR-11 (CCR-8) and deliberately unchanged; `absent` answers \"the document parsed and the field is not in it\", never \"the document could not be read\" (issue #86 tracks the bodyless-envelope class).",
  "policy": {
    "target": {
      "lro-env.example": {
        "poll": {
          "interval": "10s",
          "deadline": "90s",
          "until": { "field": "done", "terminal": [true], "absent": "pending" }
        }
      },
      "lro-env-default.example": {
        "poll": {
          "interval": "10s",
          "deadline": "90s",
          "until": { "field": "done", "terminal": [true] }
        }
      },
      "lro-bodyless.example": {
        "poll": {
          "interval": "10s",
          "deadline": "90s",
          "until": { "field": "done", "terminal": [true], "absent": "pending" }
        }
      }
    }
  },
  "steps": [
    {
      "call": {
        "target": "lro-env.example",
        "request": { "op": "POST lro-env.example/v1/projects/p/operations/op1:fetchPredictOperation", "idempotent": true, "args_hash": "h1" },
        "effect": [
          { "status": "ok", "payload": { "status": 200, "headers": [["content-type", "application/json"]], "body_b64": "eyJuYW1lIjoicHJvamVjdHMvcC9vcGVyYXRpb25zL29wMSJ9" } },
          { "status": "ok", "payload": { "status": 200, "headers": [["content-type", "application/json"]], "body_b64": "eyJuYW1lIjoicHJvamVjdHMvcC9vcGVyYXRpb25zL29wMSJ9" } },
          { "status": "ok", "payload": { "status": 200, "headers": [["content-type", "application/json"]], "body_b64": "eyJuYW1lIjoicHJvamVjdHMvcC9vcGVyYXRpb25zL29wMSJ9" } },
          { "status": "ok", "payload": { "status": 200, "headers": [["content-type", "application/json"]], "body_b64": "eyJuYW1lIjoicHJvamVjdHMvcC9vcGVyYXRpb25zL29wMSIsImRvbmUiOnRydWUsInJlc3BvbnNlIjp7InZpZGVvcyI6MX19" } }
        ],
        "expect": {
          "result": "ok",
          "payload": { "status": 200, "body_b64": "eyJuYW1lIjoicHJvamVjdHMvcC9vcGVyYXRpb25zL29wMSIsImRvbmUiOnRydWUsInJlc3BvbnNlIjp7InZpZGVvcyI6MX19" },
          "attempts": 4,
          "from_cache": false,
          "waits_ms": [],
          "throttled": false
        }
      }
    },
    {
      "call": {
        "target": "lro-env-default.example",
        "request": { "op": "POST lro-env-default.example/v1/projects/p/operations/op1:fetchPredictOperation", "idempotent": true, "args_hash": "h2" },
        "effect": [
          { "status": "ok", "payload": { "status": 200, "headers": [["content-type", "application/json"]], "body_b64": "eyJuYW1lIjoicHJvamVjdHMvcC9vcGVyYXRpb25zL29wMSJ9" } }
        ],
        "expect": {
          "result": "ok",
          "payload": { "status": 200, "body_b64": "eyJuYW1lIjoicHJvamVjdHMvcC9vcGVyYXRpb25zL29wMSJ9" },
          "attempts": 1,
          "from_cache": false,
          "waits_ms": [],
          "throttled": false
        }
      }
    },
    {
      "call": {
        "target": "lro-bodyless.example",
        "request": { "op": "POST lro-bodyless.example/v1/projects/p/operations/op1:fetchPredictOperation", "idempotent": true, "args_hash": "h3" },
        "effect": [
          { "status": "ok", "payload": { "status": 204, "headers": [] } }
        ],
        "expect": {
          "result": "ok",
          "payload": { "status": 204 },
          "attempts": 1,
          "from_cache": false,
          "waits_ms": [],
          "throttled": false
        }
      }
    },
    {
      "report_expect": {
        "clock_ms": 30000,
        "targets": {
          "lro-env.example": { "calls": 1, "attempts": 4, "retries": 0, "successes": 1, "failures": 0 },
          "lro-env-default.example": { "calls": 1, "attempts": 1, "retries": 0, "successes": 1, "failures": 0 },
          "lro-bodyless.example": { "calls": 1, "attempts": 1, "retries": 0, "successes": 1, "failures": 0 }
        }
      }
    }
  ]
}
